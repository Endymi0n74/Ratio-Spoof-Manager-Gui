{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ratio Spoof Manager",
  "version": "2.0.10",
  "identifier": "com.endymi0n74.ratio-spoof-manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run engine:fetch && npm run dev",
    "beforeBuildCommand": "npm run engine:fetch && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ratio Spoof Manager",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://github.com",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/*"
    ],
    "externalBin": [
      "binaries/ratio-spoof"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "../packaging/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxNTIzRjlCMzA2MkJDQkMKUldTOHZHSXdtejlTMGRBeEt1K2ZmNDJQN1E2aTBac29BWkh5amdDd1JNM0ZyY3MvNU9lUkJ0ZkcK",
      "endpoints": [
        "https://github.com/Endymi0n74/Ratio-Spoof-Manager-Gui/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
