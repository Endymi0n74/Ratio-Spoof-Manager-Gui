# Dependencies
node_modules/
# package-lock.json est volontairement versionné : le workflow de release en a besoin
# (`npm ci` + cache npm) et il fige exactement l'arbre installé en local.
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
build/
out/

# Tauri
src-tauri/target/
src-tauri/gen/
# src-tauri/Cargo.lock est versionné : c'est une application, pas une bibliothèque. Sans
# lui, chaque build résout de nouvelles versions de crates et la CI peut tomber sur un
# décalage majeur/mineur avec les paquets npm (le CLI Tauri refuse alors de builder).

# Sidecar : téléchargé depuis la release du moteur (scripts/fetch-engine.mjs + engine.lock.json),
# jamais versionné ici — le dépôt moteur en est la seule source de vérité.
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# Testing
coverage/

# Misc
.cache/
.temp/
